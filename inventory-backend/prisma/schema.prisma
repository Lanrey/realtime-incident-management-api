// Prisma Schema for Inventory Management System
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Supplier Entity - Vendors who supply products
model Supplier {
  id              String          @id @default(uuid())
  name            String
  contactEmail    String
  contactPhone    String
  address         String?
  isActive        Boolean         @default(true)
  products        Product[]
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive])
  @@map("suppliers")
}

// Warehouse Entity - Storage locations for products
model Warehouse {
  id              String          @id @default(uuid())
  name            String
  location        String
  capacity        Int             // Maximum number of items
  currentStock    Int             @default(0) // Current total items stored
  isActive        Boolean         @default(true)
  productStocks   ProductStock[]
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([id, capacity])
  @@index([isActive])
  @@map("warehouses")
}

// Product Entity - Items in inventory
model Product {
  id                String          @id @default(uuid())
  sku               String          @unique
  name              String
  description       String?
  reorderThreshold  Int             // Minimum stock before reordering
  reorderQuantity   Int             @default(100) // Default quantity to order
  leadTimeDays      Int             @default(3) // Days for delivery
  unitPrice         Float           @default(0)
  isActive          Boolean         @default(true)
  defaultSupplierId String
  defaultSupplier   Supplier        @relation(fields: [defaultSupplierId], references: [id], onDelete: Restrict)
  stockRecords      ProductStock[]
  purchaseOrders    PurchaseOrder[]
  stockMovements    StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([sku])
  @@index([reorderThreshold])
  @@index([isActive])
  @@map("products")
}

// ProductStock Entity - Tracks product quantity per warehouse
model ProductStock {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  lastUpdated DateTime  @default(now())

  @@unique([productId, warehouseId])
  @@index([quantity, productId])
  @@index([warehouseId])
  @@map("product_stocks")
}

// PurchaseOrder Entity - Orders placed to suppliers
model PurchaseOrder {
  id                  String       @id @default(uuid())
  orderNumber         String       @unique
  productId           String
  product             Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierId          String
  supplier            Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId         String
  warehouse           Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantityOrdered     Int
  totalCost           Float        @default(0)
  status              OrderStatus  @default(PENDING)
  orderDate           DateTime     @default(now())
  expectedArrivalDate DateTime
  actualArrivalDate   DateTime?
  notes               String?
  isAutoGenerated     Boolean      @default(false) // Track if auto-generated by system
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status, expectedArrivalDate])
  @@index([warehouseId, status])
  @@index([productId, status])
  @@index([orderDate])
  @@map("purchase_orders")
}

// StockMovement Entity - Audit trail for all stock changes
model StockMovement {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  movementType MovementType
  quantity    Int          // Positive for additions, negative for reductions
  reason      String?
  reference   String?      // Reference to PO number or adjustment ID
  performedBy String?      // User ID or 'SYSTEM'
  createdAt   DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@map("stock_movements")
}

// Alert Entity - System alerts for capacity, low stock, etc.
model Alert {
  id          String      @id @default(uuid())
  type        AlertType
  severity    AlertSeverity @default(WARNING)
  message     String
  metadata    Json?       // Additional context data
  isResolved  Boolean     @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([type, isResolved])
  @@index([createdAt])
  @@map("alerts")
}

// Enums
enum OrderStatus {
  PENDING
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

enum MovementType {
  PURCHASE_ORDER_ARRIVAL
  MANUAL_ADJUSTMENT
  RETURN_TO_SUPPLIER
  DAMAGED
  SOLD
}

enum AlertType {
  LOW_STOCK
  CAPACITY_WARNING
  CAPACITY_EXCEEDED
  ORDER_DELAYED
  SYSTEM_ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}
