# Production Environment Configuration
# Copy this file to .env and replace with actual values

# ===================================
# Database Configuration
# ===================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=inventory_db

# ===================================
# Redis Configuration
# ===================================
REDIS_PASSWORD=changeme_redis_password

# ===================================
# RabbitMQ Configuration
# ===================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=changeme_rabbitmq_password

# ===================================
# Application Configuration
# ===================================
STOCK_CHECK_INTERVAL=5

# ===================================
# CORS Configuration
# ===================================
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:5173,https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ===================================
# Security Notes
# ===================================
# 1. Generate strong passwords using: openssl rand -base64 32
# 2. Never commit .env file to version control
# 3. Use different passwords for each service
# 4. Rotate passwords regularly in production
